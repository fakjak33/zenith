{
  "name": "expected_move",
  "ref": "repro:expected_move",
  "built": "2026-10-24",
  "claim": "The expected move (about 1 standard deviation; 16-delta strikes) contains the underlying about 68% of the time",
  "tasty_value": "About 68% of outcomes fall within 1 SD; a 1-SD (16-delta) strike has about a 16% chance of finishing ITM",
  "tasty_sources": [
    "page:concepts-standard-deviation",
    "page:concepts-implied-volatility"
  ],
  "tasty_note": "tastylive states the normal-theory figure; our test found 83.9% inside the band.",
  "our_value": "SPX finished inside the VIX 1-sigma band 83.9% of the time (normal theory 68.3%), touched outside it on 26.1% of paths; realized moves had 0.75x the implied sigma.",
  "data": "Yahoo ^GSPC and ^VIX daily closes",
  "period": "1990-01-02 to 2026-09-23",
  "method": "Band = S x VIX x sqrt(30/365) around each day's close; finish = last close on or before t+30 calendar days; touch = any close outside the band in between. Overlapping windows.",
  "caveats": [
    "VIX is the variance-swap implied vol (weighted toward OTM puts), slightly above ATM IV, so the band is a bit wider than the ATM expected move brokers quote.",
    "Price only, no dividends; drift over 30 days shifts results by a fraction of a point.",
    "Touch uses closes; intraday touches are more frequent.",
    "Overlapping 30-day windows: n overstates independent observations ~21-fold."
  ],
  "verdict": "mixed",
  "claims": [
    {
      "text": "The expected move (about 1 standard deviation; 16-delta strikes) contains the underlying about 68% of the time",
